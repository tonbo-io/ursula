{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "coldStorage": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "coldStorage"
        ]
      },
      "then": {
        "properties": {
          "s3": {
            "properties": {
              "bucket": {
                "minLength": 1
              }
            },
            "required": [
              "bucket"
            ]
          }
        },
        "required": [
          "s3"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "snapshotStore": {
            "properties": {
              "backend": {
                "const": "s3"
              }
            },
            "required": [
              "backend"
            ]
          }
        },
        "required": [
          "snapshotStore"
        ]
      },
      "then": {
        "properties": {
          "s3": {
            "properties": {
              "bucket": {
                "minLength": 1
              }
            },
            "required": [
              "bucket"
            ]
          }
        },
        "required": [
          "s3"
        ]
      }
    }
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shared chart defaults used by server, gateway, and test pods.",
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "description": "Global image settings shared by components when component-level overrides are empty.",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "Image repository."
            },
            "tag": {
              "type": "string",
              "description": "Image tag. Empty uses Chart appVersion."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "description": "Image pull policy."
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ]
        },
        "imagePullSecrets": {
          "type": "array",
          "description": "Image pull secret references rendered on server, gateway, and test pods.",
          "items": {
            "type": "object"
          }
        },
        "clusterDomain": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "Kubernetes cluster DNS domain used for generated peer FQDNs, the cluster manifests and gateway upstreams. A change rolls like any restart while the old domain still resolves."
        }
      },
      "required": [
        "image",
        "imagePullSecrets",
        "clusterDomain"
      ]
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Override the chart name portion of generated resource names."
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 61,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Override the full generated release name."
    },
    "deploymentContract": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional infrastructure-generated identity and S3 contract checked during Helm rendering.",
      "properties": {
        "expectedNamespace": {
          "type": "string"
        },
        "serverServiceAccountName": {
          "type": "string"
        },
        "serverRoleArn": {
          "type": "string"
        },
        "serverS3Prefix": {
          "type": "string"
        }
      },
      "required": [
        "expectedNamespace",
        "serverServiceAccountName",
        "serverRoleArn",
        "serverS3Prefix"
      ]
    },
    "serviceAccount": {
      "type": "object",
      "description": "ServiceAccount identity for server, gateway, and test pods.",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create a dedicated ServiceAccount."
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "ServiceAccount name override."
        },
        "annotations": {
          "type": "object",
          "description": "ServiceAccount annotations.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean",
          "description": "Whether to mount Kubernetes API tokens into pods."
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ursula server StatefulSet, Services, and runtime settings.",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "enum": [
            1,
            3,
            5
          ],
          "description": "Fresh-cluster Ursula voter pod count. Supported values are 1, 3, and 5."
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 21,
          "description": "Voter termination grace period; must exceed the server's overall 20-second shutdown budget, including leadership handoff."
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "client": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "cluster": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Cluster-plane (Raft gRPC) port, used when server.clusterListen is true. Only the headless peer Service exposes it."
            }
          },
          "required": [
            "client",
            "cluster"
          ]
        },
        "clusterListen": {
          "type": "boolean",
          "description": "Serve the cluster plane on server.ports.cluster (server.cluster_listen). Peers dial that port and the client Service never exposes it. false serves both planes on server.ports.client."
        },
        "adminListen": {
          "type": "string",
          "pattern": "^[^:]+:[0-9]+$",
          "description": "Admin-plane listen address. Defaults to pod loopback; use a pod-reachable address only for a trusted in-cluster operator."
        },
        "clusterId": {
          "type": "string",
          "pattern": "^([A-Za-z0-9._-]{1,64})?$",
          "description": "server.cluster_id, sent as Ursula-Cluster-Id on every HEAD. Required for every install: name the environment and region. Keep it when a restore replaces the deployment."
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "enabled",
            "type",
            "port",
            "annotations"
          ]
        },
        "headlessService": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "annotations"
          ]
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render a NetworkPolicy for the server pods."
            },
            "clientIngressFrom": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "NetworkPolicy peers allowed to reach the client port. Empty admits every source."
            }
          },
          "required": [
            "enabled",
            "clientIngressFrom"
          ]
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rustLog": {
          "type": "string"
        },
        "coreCount": {
          "type": "integer",
          "minimum": 1
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true,
          "description": "Pod-level securityContext for Ursula server pods."
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": true,
          "description": "Container-level securityContext for the Ursula server container."
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "description": "TCP probe settings for the Ursula server.",
          "properties": {
            "startup": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "failureThreshold": {
                  "type": "integer",
                  "minimum": 1
                },
                "periodSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "enabled",
                "failureThreshold",
                "periodSeconds",
                "timeoutSeconds"
              ]
            },
            "readiness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "periodSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "periodSeconds",
                "timeoutSeconds"
              ]
            },
            "liveness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "periodSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "enabled",
                "periodSeconds",
                "timeoutSeconds"
              ]
            }
          },
          "required": [
            "startup",
            "readiness",
            "liveness"
          ]
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "enabled",
            "maxUnavailable"
          ]
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "affinity": {
              "type": "object"
            },
            "topologySpreadConstraints": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "nodeSelector",
            "tolerations",
            "affinity",
            "topologySpreadConstraints"
          ]
        }
      },
      "required": [
        "replicaCount",
        "ports",
        "adminListen",
        "service",
        "headlessService",
        "podAnnotations",
        "podLabels",
        "rustLog",
        "coreCount",
        "extraArgs",
        "extraEnv",
        "extraEnvFrom",
        "resources",
        "podSecurityContext",
        "securityContext",
        "probes",
        "podDisruptionBudget",
        "scheduling",
        "clusterListen",
        "networkPolicy"
      ]
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stateless Ursula gateway proxy settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the gateway Deployment and Service."
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of gateway replicas."
        },
        "image": {
          "type": "object",
          "description": "Gateway image settings. Empty fields inherit the global image settings.",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Gateway image repository. Empty inherits global.image.repository."
            },
            "tag": {
              "type": "string",
              "description": "Gateway image tag. Empty inherits global.image.tag or appVersion."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "",
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "description": "Gateway image pull policy. Empty inherits global.image.pullPolicy."
            }
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "http"
          ]
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "description": "Gateway Service settings.",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ],
              "description": "Gateway Service type."
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Gateway Service port."
            },
            "trafficDistribution": {
              "type": "string",
              "enum": [
                "",
                "PreferClose",
                "PreferSameZone",
                "PreferSameNode"
              ],
              "description": "Optional Kubernetes Service traffic distribution preference. PreferSameZone requires Kubernetes 1.35 or a cluster that enables the corresponding feature gate."
            },
            "annotations": {
              "type": "object",
              "description": "Gateway Service annotations.",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "port",
            "trafficDistribution",
            "annotations"
          ]
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional Ingress resource for the gateway Service.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render an Ingress resource."
            },
            "className": {
              "type": "string",
              "description": "Optional IngressClass name."
            },
            "annotations": {
              "type": "object",
              "description": "Ingress annotations.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "labels": {
              "type": "object",
              "description": "Extra labels applied only to the Ingress resource.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "hosts": {
              "type": "array",
              "description": "Ingress rule hosts. Required when gateway.ingress.enabled=true.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Fully-qualified host name."
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "description": "HTTP paths routed to the Service.",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^/",
                          "description": "URL path beginning with /."
                        },
                        "pathType": {
                          "type": "string",
                          "enum": [
                            "Prefix",
                            "Exact",
                            "ImplementationSpecific"
                          ],
                          "description": "Kubernetes Ingress path type."
                        }
                      },
                      "required": [
                        "path",
                        "pathType"
                      ]
                    }
                  }
                },
                "required": [
                  "host",
                  "paths"
                ]
              }
            },
            "tls": {
              "type": "array",
              "description": "TLS entries rendered into spec.tls.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "secretName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Existing Kubernetes TLS Secret name."
                  },
                  "hosts": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Hosts covered by the TLS Secret.",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "secretName",
                  "hosts"
                ]
              }
            }
          },
          "required": [
            "enabled",
            "className",
            "annotations",
            "labels",
            "hosts",
            "tls"
          ]
        },
        "corsAllowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Origins allowed to read across origins, or a single \"*\". Empty disables CORS."
        },
        "upstreams": {
          "type": "array",
          "description": "Manual upstream URLs. When empty, upstreams are auto-generated from Ursula headless Service pod DNS. Each must reach one node, with nothing in between that resends requests or answers 401, 402 or 429.",
          "items": {
            "type": "string"
          }
        },
        "podAnnotations": {
          "type": "object",
          "description": "Extra annotations applied to gateway pods.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "description": "Extra labels applied to gateway pods.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rustLog": {
          "type": "string",
          "description": "Rust tracing filter passed through RUST_LOG."
        },
        "connectTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "TCP connect timeout per upstream attempt in seconds."
        },
        "responseHeaderTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout for upstream response headers in seconds."
        },
        "upstreamTcpUserTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds data sent to an upstream may stay unacknowledged before the connection closes (Linux TCP_USER_TIMEOUT)."
        },
        "maxRequestBodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432,
          "description": "Maximum request body bytes buffered for leader-redirect replay. At most 32 MiB, the protocol's request limit. Must fit the body budget less its 32 MiB small-body headroom."
        },
        "bodyBudgetBytes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Bytes of request bodies the gateway buffers at once, across requests (--body-budget-bytes, 0.7.6 and later). Unset, the gateway uses 256 MiB or maxRequestBodyBytes plus 32 MiB, whichever is larger."
        },
        "gracefulShutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum graceful shutdown drain time after SIGTERM, in seconds."
        },
        "extraArgs": {
          "type": "array",
          "description": "Extra CLI args appended after generated gateway args.",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "description": "Extra environment variables for the gateway.",
          "items": {
            "type": "object"
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "description": "Extra envFrom blocks for the gateway.",
          "items": {
            "type": "object"
          }
        },
        "resources": {
          "type": "object",
          "description": "Container resource requests and limits for the gateway."
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true,
          "description": "Pod-level securityContext for gateway pods."
        },
        "securityContext": {
          "type": "object",
          "additionalProperties": true,
          "description": "Container-level securityContext for the gateway."
        },
        "probes": {
          "type": "object",
          "description": "Kubernetes probe settings for the gateway.",
          "properties": {
            "startup": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable startupProbe for the gateway."
                },
                "failureThreshold": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Startup probe failure threshold."
                },
                "periodSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Startup probe period."
                }
              }
            },
            "readiness": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable readinessProbe for the gateway."
                },
                "periodSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Readiness probe period."
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Readiness probe timeout."
                }
              }
            },
            "liveness": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable livenessProbe for the gateway."
                },
                "periodSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Liveness probe period."
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Liveness probe timeout."
                }
              }
            }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "description": "PodDisruptionBudget settings for the gateway.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable PDB for the gateway."
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 0,
              "description": "Maximum voluntary disruptions for gateway replicas."
            }
          },
          "required": [
            "enabled",
            "maxUnavailable"
          ]
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "description": "HorizontalPodAutoscaler settings for the gateway.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable HPA for the gateway."
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1,
              "description": "Minimum number of gateway replicas."
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum number of gateway replicas."
            },
            "targetCPUUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100,
              "description": "Target CPU utilization percentage for HPA."
            },
            "targetMemoryUtilizationPercentage": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100,
              "description": "Target memory utilization percentage for HPA."
            },
            "behavior": {
              "type": "object",
              "description": "HPA scaling behavior."
            }
          }
        },
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerations": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "affinity": {
              "type": "object"
            },
            "topologySpreadConstraints": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "nodeSelector",
            "tolerations",
            "affinity",
            "topologySpreadConstraints"
          ]
        },
        "initContainers": {
          "type": "array",
          "description": "Init containers to run before the gateway container.",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "ports",
        "service",
        "ingress",
        "upstreams",
        "podAnnotations",
        "podLabels",
        "rustLog",
        "connectTimeoutSeconds",
        "responseHeaderTimeoutSeconds",
        "upstreamTcpUserTimeoutSeconds",
        "maxRequestBodyBytes",
        "gracefulShutdownTimeoutSeconds",
        "extraArgs",
        "extraEnv",
        "extraEnvFrom",
        "resources",
        "podSecurityContext",
        "securityContext",
        "probes",
        "podDisruptionBudget",
        "autoscaling",
        "scheduling",
        "initContainers"
      ]
    },
    "raft": {
      "type": "object",
      "description": "Static Raft cluster settings.",
      "properties": {
        "groupCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of Raft groups."
        },
        "initMembership": {
          "type": "boolean",
          "description": "Membership bootstrap from every voter, with the same empty-voter check as initMembershipPerGroup, which turns it on as well."
        },
        "initMembershipPerGroup": {
          "type": "boolean",
          "description": "Idempotent per-group membership bootstrap. A replica that ever held its group never initializes it again; one that holds nothing initializes only once every voter reports an empty group."
        },
        "logDir": {
          "type": "string",
          "minLength": 1,
          "description": "Raft log directory, mounted from each pod's raft-data PVC. Renders raft.wal.path."
        },
        "walFsync": {
          "type": "string",
          "enum": [
            "always",
            "never"
          ],
          "description": "When Raft WAL appends reach stable storage (default never): never acknowledges from the page cache, so a host crash can cost this replica its unsynced tail and it rejoins through the recovery gate; always acknowledges after fsync."
        },
        "walSegmentBytes": {
          "type": "integer",
          "minimum": 4096,
          "description": "Size at which each core's Raft WAL journal starts a new segment; purge deletes whole segments. Renders raft.wal.segment_size."
        },
        "walCacheBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Recent Raft entries kept in memory across the node, split evenly between its groups; older entries are read from disk. Renders raft.wal.cache_size."
        },
        "minAvailableBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Free WAL filesystem bytes below which writes and readiness are rejected; zero disables."
        },
        "resumeAvailableBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Free WAL filesystem bytes required before pressure clears."
        },
        "maxUncommittedBytesPerGroup": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Optional raft uncommitted byte cap per group; 0 disables the cap."
        },
        "snapshotPressureMaxGroupsPerTick": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum groups snapshotted in one pressure pass while the node's Raft log is below its budget. Past the budget a pass starts this many for each snapshot build it keeps in flight."
        },
        "snapshotBuildMaxConcurrency": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 16,
          "description": "Snapshot builds a node runs at once. The snapshot driver keeps one in flight while the node's Raft log is below its budget, and past it more, up to this many before the hard limit of twice the budget. Null keeps each server's own default (2 from 0.7.4, 1 before)."
        },
        "snapshotBackstopLogs": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Far entry backstop of the snapshot driver, rendered as raft.snapshot_backstop_logs. A group snapshots once it applied this many entries since its last snapshot. Null keeps the server default (100000)."
        },
        "maxInSnapshotLogToKeep": {
          "type": "integer",
          "minimum": 0,
          "description": "Payload-bearing raft log entries retained per group after snapshot coverage."
        },
        "deletedDataMaxAgeMs": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Milliseconds a replica keeps a deleted, purged or expired stream in its current Raft snapshot and its Raft log after it applies the removal. At least eight times the install snapshot timeout. Null keeps each server's own default, the larger of 1 hour and eight install timeouts."
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "description": "Settings of the raft-data PVC every server pod gets for its Raft WAL.",
      "properties": {
        "storageClassName": {
          "type": "string",
          "description": "StorageClass name. Empty uses default."
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "description": "PVC access modes.",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "description": "PVC size."
        },
        "annotations": {
          "type": "object",
          "description": "PVC annotations.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "s3": {
      "type": "object",
      "description": "Shared S3-compatible object storage settings.",
      "properties": {
        "bucket": {
          "type": "string",
          "description": "Shared S3 bucket. Required when coldStorage.enabled=true or snapshotStore.backend=s3."
        },
        "region": {
          "type": "string",
          "description": "S3 region."
        },
        "endpoint": {
          "type": "string",
          "description": "Optional S3-compatible endpoint."
        },
        "prefix": {
          "type": "string",
          "description": "Shared object prefix used with coldStorage.prefix to build storage.cold.root when coldStorage.enabled=true; not rendered into a cold root when cold storage is disabled."
        },
        "credentials": {
          "type": "object",
          "description": "Shared S3 credential settings.",
          "properties": {
            "accessKeyId": {
              "type": "string",
              "description": "Inline S3 access key."
            },
            "secretAccessKey": {
              "type": "string",
              "description": "Inline S3 secret key."
            },
            "sessionToken": {
              "type": "string",
              "description": "Optional inline S3 session token."
            },
            "existingSecret": {
              "type": "string",
              "description": "Existing Secret containing credentials. When set, inline credentials are not allowed."
            }
          }
        }
      }
    },
    "coldStorage": {
      "type": "object",
      "description": "Shared cold storage settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable cold storage in the generated Ursula config."
        },
        "backend": {
          "type": "string",
          "enum": [
            "s3"
          ],
          "description": "Cold backend."
        },
        "prefix": {
          "type": "string",
          "description": "Cold object prefix below s3.prefix."
        },
        "flush": {
          "type": "object",
          "description": "Background cold flush settings.",
          "properties": {
            "intervalMs": {
              "type": "integer",
              "minimum": 1,
              "description": "Background cold flush interval in milliseconds."
            },
            "minHotBytes": {
              "type": "integer",
              "minimum": 1,
              "description": "Skip flush below this hot byte threshold per group."
            },
            "pressureHotBytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Aggregate hot bytes across locally led groups that trigger draining undersized groups; 0 disables pressure flushing."
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum bytes flushed per group per tick."
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum concurrent cold writes."
            },
            "maxHotBytesPerGroup": {
              "type": "integer",
              "minimum": 0,
              "description": "Backpressure ceiling for hot bytes per group; 0 disables the cap."
            }
          }
        },
        "compaction": {
          "type": "object",
          "description": "Same-stream cold chunk compaction settings.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable same-stream cold chunk compaction (default true)."
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 1
            },
            "targetBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxStreamsPerPass": {
              "type": "integer",
              "minimum": 1
            },
            "gcGraceMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "cache": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional cold-read cache override. Omitted values use Ursula runtime defaults.",
          "properties": {
            "maxSizeBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Maximum cold-read cache bytes; 0 disables the cache."
            },
            "blockSizeBytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "Cold-read cache block size in bytes."
            },
            "readaheadBlocks": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Number of cache blocks to read ahead."
            }
          }
        }
      }
    },
    "snapshotStore": {
      "type": "object",
      "description": "OpenRaft snapshot store settings.",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "auto",
            "inline",
            "s3"
          ],
          "description": "Snapshot backend. auto (Ursula's default) uses S3 with the S3 cold store and inline otherwise."
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/*(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.\\.[A-Za-z0-9._-]+)(/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.\\.[A-Za-z0-9._-]+))*/*$",
          "description": "Snapshot object suffix rendered as storage.snapshot.s3_prefix; resolved against storage.cold.root when present, otherwise against the S3 bucket root for S3 snapshots. Leading and trailing '/' are trimmed, and what is left is one or more components separated by single '/'s, each of ASCII letters, digits, '-', '_' and '.' and none of them '.' or '..'. Ursula refuses any other prefix at startup."
        },
        "driveIntervalMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Snapshot driver interval in milliseconds, rendered as storage.snapshot.drive_interval. The driver always runs, so 0 is refused."
        },
        "s3TimeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Per-attempt timeout of an S3 snapshot-store request in milliseconds, rendered as storage.snapshot.s3_timeout. Null keeps the server's default of 10 seconds. A PUT sends the whole object in one attempt, so this must also cover a healthy PUT of the largest snapshot. A follower's install copy, up to four requests with this timeout and s3MaxRetries, must fit inside the install snapshot timeout, or the server refuses to start."
        },
        "s3MaxRetries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Retries of an S3 snapshot-store request, rendered as storage.snapshot.s3_max_retries. Null keeps the server's default of 1."
        }
      }
    },
    "tests": {
      "type": "object",
      "description": "Helm test settings.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render Helm test Pod."
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout for ursulactl wait-ready."
        },
        "image": {
          "type": "object",
          "description": "Optional test image override.",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Optional test image repository."
            },
            "tag": {
              "type": "string",
              "description": "Optional test image tag."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "",
                "Always",
                "IfNotPresent",
                "Never"
              ],
              "description": "Optional test image pull policy."
            }
          }
        }
      }
    }
  },
  "required": [
    "global",
    "nameOverride",
    "fullnameOverride",
    "deploymentContract",
    "serviceAccount",
    "server",
    "gateway",
    "raft",
    "persistence",
    "s3",
    "coldStorage",
    "snapshotStore",
    "tests"
  ]
}
